@model EMPTRACK.Models.AuditLog

@{
    ViewData["Title"] = "Audit Log Details";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="h3 mb-1">
                Audit Log Details
            </h1>

            <p class="text-muted mb-0">
                Log #@Model.AuditLogId
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Audit Logs
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            <strong>Activity Information</strong>
        </div>

        <div class="card-body">

            <dl class="row mb-0">

                <dt class="col-sm-3">
                    Log ID
                </dt>

                <dd class="col-sm-9">
                    @Model.AuditLogId
                </dd>

                <dt class="col-sm-3">
                    User
                </dt>

                <dd class="col-sm-9">

                    @if (Model.UserAccount != null)
                    {
                        <strong>
                            @Model.UserAccount.Username
                        </strong>
                    }
                    else
                    {
                        <span class="text-muted">
                            Unknown user
                        </span>
                    }

                </dd>

                <dt class="col-sm-3">
                    Action
                </dt>

                <dd class="col-sm-9">

                    <span class="badge bg-primary">
                        @Model.Action
                    </span>

                </dd>

                <dt class="col-sm-3">
                    Target
                </dt>

                <dd class="col-sm-9">
                    @Model.Target
                </dd>

                <dt class="col-sm-3">
                    Date & Time
                </dt>

                <dd class="col-sm-9">
                    @Model.DateTime.ToString(
                        "dd MMMM yyyy hh:mm:ss tt")
                </dd>

                <dt class="col-sm-3">
                    Description
                </dt>

                <dd class="col-sm-9">

                    <div class="border rounded p-3"
                         style="white-space: pre-wrap;">
                        @Model.Description
                    </div>

                </dd>

            </dl>

        </div>

    </div>

</div>