@model EMPTRACK.Models.ViewModels.HolidayEditViewModel

@{
    ViewData["Title"] = "Edit Holiday";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Edit Holiday</h1>
        <p class="text-muted mb-0">
            Update holiday information.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit"
                  asp-route-id="@Model.HolidayId"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="HolidayId"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               maxlength="100" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Date"
                               class="form-label">
                        </label>

                        <input asp-for="Date"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Date"
                              class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Details"
                       asp-route-id="@Model.HolidayId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}