@model EMPTRACK.Models.Holiday

@{
    ViewData["Title"] = "Delete Holiday";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Delete Holiday</h1>
        <p class="text-muted mb-0">
            Confirm that you want to delete this company holiday.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="alert alert-warning">
                Are you sure you want to delete this holiday?
            </div>

            <dl class="row mb-4">
                <dt class="col-sm-3">Holiday Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">@Model.Date.ToString("dd MMMM yyyy")</dd>
            </dl>

            <form asp-action="Delete"
                  asp-route-id="@Model.HolidayId"
                  method="post"
                  class="d-inline">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Delete
                </button>
            </form>

            <a asp-action="Details"
               asp-route-id="@Model.HolidayId"
               class="btn btn-outline-secondary">
                Cancel
            </a>
        </div>
    </div>
</div>
