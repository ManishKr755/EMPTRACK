@model EMPTRACK.Models.ViewModels.HolidayCreateViewModel

@{
    ViewData["Title"] = "Create Holiday";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Create Holiday</h1>
        <p class="text-muted mb-0">
            Add a company holiday.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               maxlength="100"
                               placeholder="Holiday name" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Date"
                               class="form-label">
                        </label>

                        <input asp-for="Date"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Date"
                              class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Create Holiday
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}