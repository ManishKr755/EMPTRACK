@model EMPTRACK.Models.ViewModels.AnnouncementCreateViewModel

@{
    ViewData["Title"] = "Create Announcement";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Create Announcement</h1>
        <p class="text-muted mb-0">
            Publish an announcement for employees.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Title"
                               class="form-label">
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               maxlength="200"
                               placeholder="Announcement title" />

                        <span asp-validation-for="Title"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AudienceType" class="form-label">Audience</label>
                        <select asp-for="AudienceType" class="form-select">
                            <option value="AllExceptAdmin">All employees</option>
                            <option value="Department">Specific department</option>
                        </select>
                        <span asp-validation-for="AudienceType" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DepartmentId" class="form-label">Department (when targeted)</label>
                        <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select">
                            <option value="">Select department</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Content"
                               class="form-label">
                        </label>

                        <textarea asp-for="Content"
                                  class="form-control"
                                  rows="8"
                                  maxlength="2000"
                                  placeholder="Write the announcement..."></textarea>

                        <span asp-validation-for="Content"
                              class="text-danger"></span>
                    </div>


                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Create Announcement
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}