@model EMPTRACK.Models.Announcement
@{
    ViewData["Title"] = "Delete Announcement";
}
<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Delete Announcement</h1>
        <p class="text-muted mb-0">Confirm that you want to delete this announcement.</p>
    </div>
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="alert alert-warning">Are you sure you want to delete this announcement?</div>
            <h2 class="h4">@Model.Title</h2>
            <p class="text-muted">Published: @Model.PublishedAt.ToString("dd MMM yyyy, hh:mm tt")</p>
            <div class="mb-4" style="white-space: pre-wrap;">@Model.Content</div>
            <form asp-action="Delete" asp-route-id="@Model.AnnouncementId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Details" asp-route-id="@Model.AnnouncementId" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
