@model IEnumerable<EMPTRACK.Models.Announcement>

@{
    ViewData["Title"] = "Announcements";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Announcements</h1>
            <p class="text-muted mb-0">
                Manage company announcements.
            </p>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("HR Head"))
        {
            <a asp-action="Create" class="btn btn-primary">+ New Announcement</a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header">
            <strong>Announcement List</strong>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-muted">
                    No announcements found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Content</th>
                                <th>Published At</th>
                                <th class="text-end">
                                    Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var announcement in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>
                                            @announcement.Title
                                        </strong>
                                    </td>

                                    <td>
                                        @(announcement.Content.Length > 100
                                            ? announcement.Content[..100] + "..."
                                            : announcement.Content)
                                    </td>

                                    <td>
                                        @announcement.PublishedAt.ToString("dd-MM-yyyy hh:mm tt")
                                    </td>

                                    <td class="text-end">
                                        <a asp-action="Details"
                                           asp-route-id="@announcement.AnnouncementId"
                                           class="btn btn-sm btn-outline-secondary">
                                            Details
                                        </a>

                                        @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("HR Head"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@announcement.AnnouncementId" class="btn btn-sm btn-outline-primary">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@announcement.AnnouncementId" class="btn btn-sm btn-outline-danger">Delete</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>