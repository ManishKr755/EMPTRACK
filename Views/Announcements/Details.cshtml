@model EMPTRACK.Models.Announcement

@{
    ViewData["Title"] = "Announcement Details";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Announcement Details</h1>
            <p class="text-muted mb-0">
                Announcement #@Model.AnnouncementId
            </p>
        </div>

        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.AnnouncementId" class="btn btn-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.AnnouncementId" class="btn btn-outline-danger">Delete</a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <strong>Announcement</strong>

                <span class="text-muted small">
                    @Model.PublishedAt.ToString("dd MMM yyyy, hh:mm tt")
                </span>
            </div>
        </div>

        <div class="card-body">
            <h2 class="h4 mb-3">
                @Model.Title
            </h2>

            <hr />

            <div style="white-space: pre-wrap;">@Model.Content</div>
        </div>

    
    </div>
</div>