@model EMPTRACK.Models.ViewModels.DepartmentEditViewModel

@{
    ViewData["Title"] = "Edit Department";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Edit Department</h1>
        <p class="text-muted mb-0">
            Update department information and department heads.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit"
                  asp-route-id="@Context.Request.RouteValues["id"]"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Code" class="form-label"></label>

                        <input asp-for="Code"
                               class="form-control"
                               autocomplete="off" />

                        <span asp-validation-for="Code"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>

                        <input asp-for="Name"
                               class="form-control"
                               autocomplete="off" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HeadManagerEmployeeId"
                               class="form-label">
                        </label>

                        <select asp-for="HeadManagerEmployeeId"
                                asp-items="ViewBag.HeadManagers"
                                class="form-select">
                            <option value="">-- No Head Manager --</option>
                        </select>

                        <div class="form-text">
                            The Head Manager must belong to this department.
                        </div>

                        <span asp-validation-for="HeadManagerEmployeeId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HeadHREmployeeId"
                               class="form-label">
                        </label>

                        <select asp-for="HeadHREmployeeId"
                                asp-items="ViewBag.HRHeads"
                                class="form-select">
                            <option value="">-- No HR Head --</option>
                        </select>

                        <div class="form-text">
                            HR Head can only be assigned to the HR department.
                        </div>

                        <span asp-validation-for="HeadHREmployeeId"
                              class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Details"
                       asp-route-id="@Context.Request.RouteValues["id"]"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}