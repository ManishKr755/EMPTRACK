@model EMPTRACK.Models.Department

@{
    ViewData["Title"] = "Department Details";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">@Model.Name</h1>
            <p class="text-muted mb-0">
                Department code: @Model.Code
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit"
               asp-route-id="@Model.DepartmentId"
               class="btn btn-primary">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <strong>Department Information</strong>
                </div>

                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">
                            Code
                        </dt>

                        <dd class="col-sm-7">
                            @Model.Code
                        </dd>

                        <dt class="col-sm-5">
                            Name
                        </dt>

                        <dd class="col-sm-7">
                            @Model.Name
                        </dd>

                        <dt class="col-sm-5">
                            Head Manager
                        </dt>

                        <dd class="col-sm-7">
                            @if (Model.HeadManager != null)
                            {
                                <div>
                                    <strong>
                                        @Model.HeadManager.FirstName
                                        @Model.HeadManager.LastName
                                    </strong>
                                </div>

                                <small class="text-muted">
                                    @Model.HeadManager.EmployeeCode
                                </small>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not assigned
                                </span>
                            }
                        </dd>

                        <dt class="col-sm-5">
                            HR Head
                        </dt>

                        <dd class="col-sm-7">
                            @if (Model.HeadHREmployee != null)
                            {
                                <div>
                                    <strong>
                                        @Model.HeadHREmployee.FirstName
                                        @Model.HeadHREmployee.LastName
                                    </strong>
                                </div>

                                <small class="text-muted">
                                    @Model.HeadHREmployee.EmployeeCode
                                </small>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not assigned
                                </span>
                            }
                        </dd>

                        <dt class="col-sm-5">
                            Employees
                        </dt>

                        <dd class="col-sm-7">
                            @Model.Employees.Count
                        </dd>

                        <dt class="col-sm-5">
                            Teams
                        </dt>

                        <dd class="col-sm-7">
                            @Model.Teams.Count
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <strong>Employees</strong>
                </div>

                <div class="card-body p-0">
                    @if (!Model.Employees.Any())
                    {
                        <div class="p-4 text-muted text-center">
                            No employees are assigned to this department.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Code</th>
                                        <th>Name</th>
                                        <th>Role</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var employee in Model.Employees
                                        .OrderBy(e => e.FirstName)
                                        .ThenBy(e => e.LastName))
                                    {
                                        <tr>
                                            <td>
                                                @employee.EmployeeCode
                                            </td>

                                            <td>
                                                @employee.FirstName
                                                @employee.LastName
                                            </td>

                                            <td>
                                                @employee.Role
                                            </td>

                                            <td>
                                                @employee.EmploymentStatus
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Teams</strong>
                </div>

                <div class="card-body p-0">
                    @if (!Model.Teams.Any())
                    {
                        <div class="p-4 text-muted text-center">
                            No teams are assigned to this department.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Team</th>
                                        <th>Manager</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var team in Model.Teams
                                        .OrderBy(t => t.Name))
                                    {
                                        <tr>
                                            <td>
                                                @team.Name
                                            </td>

                                            <td>
                                                @if (team.ManagerEmployee != null)
                                                {
                                                    <span>
                                                        @team.ManagerEmployee.FirstName
                                                        @team.ManagerEmployee.LastName
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        Not available
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>