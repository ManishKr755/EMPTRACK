@model EMPTRACK.Models.Concern

@{
    ViewData["Title"] = "Delete Concern";
}

<div class="container-fluid">

    <div class="mb-4">
        <h1 class="h3 mb-1">Delete Concern</h1>

        <p class="text-muted mb-0">
            Confirm that this concern should be deleted.
        </p>
    </div>

    <div class="card shadow-sm border-danger">

        <div class="card-header text-danger">
            <strong>Confirm Deletion</strong>
        </div>

        <div class="card-body">

            <p>
                Are you sure you want to delete this concern?
            </p>

            <dl class="row">

                <dt class="col-sm-3">Employee</dt>
                <dd class="col-sm-9">
                    @Model.Employee.EmployeeCode -
                    @Model.Employee.FirstName
                    @Model.Employee.LastName
                </dd>

                <dt class="col-sm-3">Subject</dt>
                <dd class="col-sm-9">
                    @Model.Subject
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @Model.Status
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">
                    @Model.CreatedAt.ToString("dd MMMM yyyy hh:mm tt")
                </dd>

            </dl>

            <div class="alert alert-warning">
                This action cannot be undone.
            </div>

            <form asp-action="DeleteConfirmed"
                  method="post"
                  class="d-flex gap-2">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.ConcernId" />

                <button type="submit"
                        class="btn btn-danger">
                    Yes, Delete Concern
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.ConcernId"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>
