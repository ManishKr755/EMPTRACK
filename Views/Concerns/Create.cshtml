@model EMPTRACK.Models.ViewModels.ConcernCreateViewModel

@{
    ViewData["Title"] = "Create Concern";
}

<div class="container-fluid">

    <div class="mb-4">
        <h1 class="h3 mb-1">Create Concern</h1>

        <p class="text-muted mb-0">
            Submit a concern to HR.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="Subject"
                           class="form-label">
                    </label>

                    <input asp-for="Subject"
                           class="form-control"
                           maxlength="200"
                           placeholder="Enter concern subject" />

                    <span asp-validation-for="Subject"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Submit Concern
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}
