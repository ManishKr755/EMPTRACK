@model EMPTRACK.Models.ViewModels.EmployeeDetailsViewModel
@{ ViewData["Title"] = "Employee Details"; var isAdmin = User.IsInRole("Admin"); var currentEmployeeId = int.TryParse(User.FindFirst("EmployeeId")?.Value, out var parsedEmployeeId) ? parsedEmployeeId : (int?)null; var canEdit = isAdmin || ((User.IsInRole("HR") || User.IsInRole("Employee")) && currentEmployeeId == Model.EmployeeId); }
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h1>Employee Details</h1><p class="text-muted">View employee information.</p></div>
        <div>@if (canEdit) { <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-primary">Edit</a> }<a asp-action="Index" class="btn btn-secondary ms-2">Back to Employees</a></div>
    </div>
    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
    <div class="card shadow-sm"><div class="card-body"><dl class="row">
        <dt class="col-sm-3">Employee Code</dt><dd class="col-sm-9"><strong>@Model.EmployeeCode</strong></dd>
        <dt class="col-sm-3">Employee Serial</dt><dd class="col-sm-9">@Model.EmployeeSerial</dd>
        <dt class="col-sm-3">First Name</dt><dd class="col-sm-9">@Model.FirstName</dd>
        <dt class="col-sm-3">Last Name</dt><dd class="col-sm-9">@Model.LastName</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@(Model.Phone ?? "-")</dd>
        <dt class="col-sm-3">Role</dt><dd class="col-sm-9">@Model.Role</dd>
        <dt class="col-sm-3">Department</dt><dd class="col-sm-9">@(Model.DepartmentName ?? "-")</dd>
        <dt class="col-sm-3">Team</dt><dd class="col-sm-9">@(Model.TeamName ?? "-")</dd>
        <dt class="col-sm-3">Joining Date</dt><dd class="col-sm-9">@Model.JoiningDate.ToString("dd-MM-yyyy")</dd>
        <dt class="col-sm-3">Employment Status</dt><dd class="col-sm-9">@Model.EmploymentStatus</dd>
        @if (isAdmin)
        {
            <dt class="col-sm-3">Username</dt><dd class="col-sm-9">@(Model.Username ?? "-")</dd>

        }
    </dl></div></div>
</div>

