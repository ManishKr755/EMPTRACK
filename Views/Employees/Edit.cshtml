@model EMPTRACK.Models.ViewModels.EmployeeEditViewModel

@{
    ViewData["Title"] = "Edit Employee";
    var departments = ViewBag.Departments as IEnumerable<EMPTRACK.Models.Department> ?? Enumerable.Empty<EMPTRACK.Models.Department>();
    var teams = ViewBag.Teams as IEnumerable<EMPTRACK.Models.Team> ?? Enumerable.Empty<EMPTRACK.Models.Team>();
    var roles = ViewBag.Roles as IEnumerable<string> ?? Enumerable.Empty<string>();
    var statuses = ViewBag.EmploymentStatuses as IEnumerable<string> ?? Enumerable.Empty<string>();
    var canManagePassword = User.IsInRole("Admin");
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1 class="mb-1">Edit Employee</h1><p class="text-muted mb-0">Update employee information.</p></div>
        <a asp-action="Details" asp-route-id="@Model.EmployeeId" class="btn btn-outline-secondary">Back to Details</a>
    </div>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <form asp-action="Edit" asp-route-id="@Model.EmployeeId" method="post">
        @Html.AntiForgeryToken()
        <div class="card shadow-sm mb-4">
            <div class="card-header"><strong>System Information</strong></div>
            <div class="card-body"><div class="row">
                <div class="col-md-4 mb-3"><label class="form-label">Employee ID</label><input class="form-control" value="@Model.EmployeeId" readonly /></div>
                <div class="col-md-4 mb-3"><label class="form-label">Employee Serial</label><input class="form-control" value="@Model.EmployeeSerial" readonly /></div>
                <div class="col-md-4 mb-3"><label class="form-label">Employee Code</label><input class="form-control" value="@Model.EmployeeCode" readonly /><div class="form-text">Employee code is permanent.</div></div>
            </div></div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header"><strong>Personal Information</strong></div>
            <div class="card-body"><div class="row">
                <div class="col-md-6 mb-3"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
                <div class="col-md-6 mb-3"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
                <div class="col-md-6 mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" type="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
                <div class="col-md-6 mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" type="tel" /><span asp-validation-for="Phone" class="text-danger"></span></div>
            </div></div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header"><strong>Employment Information</strong></div>
            <div class="card-body"><div class="row">
                <div class="col-md-6 mb-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select"><option value="">-- Select Role --</option>@foreach (var role in roles) { <option value="@role">@role</option> }</select><span asp-validation-for="Role" class="text-danger"></span></div>
                <div class="col-md-6 mb-3"><label asp-for="EmploymentStatus" class="form-label"></label><select asp-for="EmploymentStatus" class="form-select">@foreach (var status in statuses) { <option value="@status">@status</option> }</select><span asp-validation-for="EmploymentStatus" class="text-danger"></span></div>
                <div class="col-md-6 mb-3"><label asp-for="DepartmentId" class="form-label"></label><select asp-for="DepartmentId" class="form-select" id="DepartmentId"><option value="">-- Select Department --</option>@foreach (var department in departments) { <option value="@department.DepartmentId">@department.Name</option> }</select><span asp-validation-for="DepartmentId" class="text-danger"></span></div>
                <div class="col-md-6 mb-3"><label asp-for="TeamId" class="form-label"></label><select asp-for="TeamId" class="form-select" id="TeamId"><option value="">-- No Team --</option>@foreach (var team in teams) { <option value="@team.TeamId" data-department="@team.DepartmentId">@team.Name</option> }</select><span asp-validation-for="TeamId" class="text-danger"></span></div>
                <div class="col-md-6 mb-3"><label asp-for="JoiningDate" class="form-label"></label><input asp-for="JoiningDate" class="form-control" type="date" /><span asp-validation-for="JoiningDate" class="text-danger"></span></div>
            </div></div>
        </div>

        @if (canManagePassword)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header"><strong>Login &amp; Password</strong></div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(Model.Username))
                    {
                        <div class="mb-3"><label class="form-label">Username</label><input class="form-control" value="@Model.Username" readonly /></div>
                    }
                    @if (Model.CurrentPassword != null)
                    {
                        <div class="mb-3">
                            <label class="form-label">Current Password</label>
                            <div class="input-group"><input id="currentEmployeePassword" class="form-control" value="@Model.CurrentPassword" type="password" readonly disabled /><button class="btn btn-outline-secondary" type="button" data-toggle-password="currentEmployeePassword" aria-label="Show current password">👁</button></div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">No decryptable password is available for this account. Set a new password below if needed.</div>
                    }
                    <div class="row">
                        <div class="col-md-6 mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" /><div class="form-text">Leave both new-password fields empty to keep the current password.</div><span asp-validation-for="NewPassword" class="text-danger"></span></div>
                        <div class="col-md-6 mb-3"><label asp-for="ConfirmNewPassword" class="form-label"></label><input asp-for="ConfirmNewPassword" class="form-control" type="password" autocomplete="new-password" /><span asp-validation-for="ConfirmNewPassword" class="text-danger"></span></div>
                    </div>
                </div>
            </div>
        }

        <div class="d-flex justify-content-end gap-2"><a asp-action="Details" asp-route-id="@Model.EmployeeId" class="btn btn-secondary">Cancel</a><button type="submit" class="btn btn-primary">Save Changes</button></div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const department = document.getElementById("DepartmentId");
            const team = document.getElementById("TeamId");
            if (department && team) {
                function filterTeams() {
                    const value = department.value;
                    Array.from(team.options).forEach(option => { if (!option.value) { option.hidden = false; return; } option.hidden = value !== "" && option.dataset.department !== value; });
                    if (team.selectedOptions[0]?.hidden) team.value = "";
                }
                department.addEventListener("change", filterTeams); filterTeams();
            }
            document.querySelectorAll("[data-toggle-password]").forEach(button => {
                button.addEventListener("click", function () {
                    const input = document.getElementById(button.dataset.togglePassword);
                    input.type = input.type === "password" ? "text" : "password";
                });
            });
        });
    </script>
}
