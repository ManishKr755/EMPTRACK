@model EMPTRACK.Models.Team

@{
    ViewData["Title"] = "Team Details";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">@Model.Name</h1>

            <p class="text-muted mb-0">
                @if (Model.Department != null)
                {
                    <span>
                        @Model.Department.Name
                    </span>
                }
            </p>
        </div>

        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin") || User.IsInRole("HR Head") || User.IsInRole("Head Manager"))
            {
                <a asp-action="Edit" asp-route-id="@Model.TeamId" class="btn btn-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.TeamId" class="btn btn-danger">Delete</a>
            }

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <strong>Team Information</strong>
                </div>

                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">
                            Team Name
                        </dt>

                        <dd class="col-sm-7">
                            @Model.Name
                        </dd>

                        <dt class="col-sm-5">
                            Department
                        </dt>

                        <dd class="col-sm-7">
                            @if (Model.Department != null)
                            {
                                <span>
                                    @Model.Department.Name
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not available
                                </span>
                            }
                        </dd>

                        <dt class="col-sm-5">
                            Manager
                        </dt>

                        <dd class="col-sm-7">
                            @if (Model.ManagerEmployee != null)
                            {
                                <div>
                                    <strong>
                                        @Model.ManagerEmployee.FirstName
                                        @Model.ManagerEmployee.LastName
                                    </strong>
                                </div>

                                <small class="text-muted">
                                    @Model.ManagerEmployee.EmployeeCode
                                </small>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not available
                                </span>
                            }
                        </dd>

                        <dt class="col-sm-5">
                            Employees
                        </dt>

                        <dd class="col-sm-7">
                            @Model.Employees.Count
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Team Members</strong>
                </div>

                <div class="card-body p-0">
                    @if (!Model.Employees.Any())
                    {
                        <div class="p-4 text-center text-muted">
                            No employees are currently assigned
                            to this team.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Employee Code</th>
                                        <th>Name</th>
                                        <th>Role</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var employee in Model.Employees
                                        .OrderBy(e => e.FirstName)
                                        .ThenBy(e => e.LastName))
                                    {
                                        <tr>
                                            <td>
                                                @employee.EmployeeCode
                                            </td>

                                            <td>
                                                @employee.FirstName
                                                @employee.LastName
                                            </td>

                                            <td>
                                                @employee.Role
                                            </td>

                                            <td>
                                                @employee.EmploymentStatus
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>