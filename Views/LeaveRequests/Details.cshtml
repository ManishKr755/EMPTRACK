@model EMPTRACK.Models.LeaveRequest

@{
    ViewData["Title"] = "Leave Request Details";

    var requestedDays =
        Model.EndDate.DayNumber -
        Model.StartDate.DayNumber + 1;

    var canViewApprover = ViewBag.CanViewApprover == true;
    var canApprove = ViewBag.CanApprove == true;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Leave Request Details</h1>
            <p class="text-muted mb-0">
                Request #@Model.LeaveRequestId
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Request Information</strong>
                </div>

                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Employee</dt>
                        <dd class="col-sm-8">
                            @Model.Employee.FirstName
                            @Model.Employee.LastName
                            <div class="small text-muted">
                                @Model.Employee.EmployeeCode
                            </div>
                        </dd>

                        <dt class="col-sm-4">Leave Type</dt>
                        <dd class="col-sm-8">
                            @Model.LeaveType.Name
                        </dd>

                        <dt class="col-sm-4">Start Date</dt>
                        <dd class="col-sm-8">
                            @Model.StartDate.ToString("dd MMMM yyyy")
                        </dd>

                        <dt class="col-sm-4">End Date</dt>
                        <dd class="col-sm-8">
                            @Model.EndDate.ToString("dd MMMM yyyy")
                        </dd>

                        <dt class="col-sm-4">Number of Days</dt>
                        <dd class="col-sm-8">@requestedDays</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.Status == "Approved")
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (Model.Status == "Rejected")
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Reason</dt>
                        <dd class="col-sm-8">
                            <div class="border rounded p-3 bg-light">
                                @Model.Reason
                            </div>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Request Status</strong>
                </div>

                <div class="card-body">
                    @if (Model.Status == "Pending")
                    {
                        <div class="alert alert-warning mb-3">
                            This request is pending.
                            No leave balance has been deducted.
                        </div>

                        @if (canApprove)
                        {
                            <div class="d-flex gap-2">
                                <form asp-action="Approve"
                                      asp-route-id="@Model.LeaveRequestId"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-success"
                                            onclick="return confirm('Approve this leave request?');">
                                        Approve
                                    </button>
                                </form>

                                <form asp-action="Reject"
                                      asp-route-id="@Model.LeaveRequestId"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-danger"
                                            onclick="return confirm('Reject this leave request?');">
                                        Reject
                                    </button>
                                </form>
                            </div>
                        }
                    }
                    else if (Model.Status == "Approved")
                    {
                        <div class="alert alert-success mb-3">
                            This request has been approved.
                        </div>

                        @if (canViewApprover && Model.ApprovedByUser != null)
                        {
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Approved By</dt>
                                <dd class="col-sm-7">
                                    @Model.ApprovedByUser.Username
                                </dd>

                                <dt class="col-sm-5">Approved At</dt>
                                <dd class="col-sm-7">
                                    @if (Model.ApprovedAt.HasValue)
                                    {
                                        @Model.ApprovedAt.Value.ToString(
                                            "dd MMM yyyy hh:mm tt")
                                    }
                                </dd>
                            </dl>
                        }
                    }
                    else
                    {
                        <div class="alert alert-danger mb-0">
                            This request has been rejected.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
