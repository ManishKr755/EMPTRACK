@model IEnumerable<EMPTRACK.Models.LeaveRequest>

@{
    ViewData["Title"] = "Leave Requests";
    var canViewAllRequests = ViewBag.CanViewAllRequests == true;
    var canCreateRequest = ViewBag.CanCreateRequest == true;
    var canApproveRequests = ViewBag.CanApproveRequests == true;
    var approvableRequestIds =
        ViewBag.ApprovableRequestIds as HashSet<int>
        ?? new HashSet<int>();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                @(canViewAllRequests ? "Leave Requests" : "My Leave Requests")
            </h1>
            <p class="text-muted mb-0">
                @(canViewAllRequests
                    ? "View relevant employee leave requests."
                    : "View your submitted leave requests.")
            </p>
        </div>

        <div class="d-flex gap-2">
            @if (canApproveRequests)
            {
                <a asp-action="Index"
                   asp-route-status="Pending"
                   class="btn btn-warning">
                    Pending Approvals
                </a>
            }

            @if (canCreateRequest)
            {
                <a asp-action="Create"
                   class="btn btn-primary">
                    + New Leave Request
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    @if (canViewAllRequests)
                    {
                        <div class="col-md-3">
                            <label class="form-label">Employee</label>
                            <select name="employeeId"
                                    asp-items="ViewBag.EmployeeFilter"
                                    class="form-select">
                                <option value="">All Employees</option>
                            </select>
                        </div>
                    }

                    <div class="col-md-3">
                        <label class="form-label">Leave Type</label>
                        <select name="leaveTypeId"
                                asp-items="ViewBag.LeaveTypeFilter"
                                class="form-select">
                            <option value="">All Leave Types</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-select">
                            <option value="">All Statuses</option>
                            <option value="Pending"
                                    selected="@(ViewData["Status"]?.ToString() == "Pending")">
                                Pending
                            </option>
                            <option value="Approved"
                                    selected="@(ViewData["Status"]?.ToString() == "Approved")">
                                Approved
                            </option>
                            <option value="Rejected"
                                    selected="@(ViewData["Status"]?.ToString() == "Rejected")">
                                Rejected
                            </option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">From Date</label>
                        <input type="date"
                               name="startDate"
                               value="@ViewData["StartDate"]"
                               class="form-control" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">To Date</label>
                        <input type="date"
                               name="endDate"
                               value="@ViewData["EndDate"]"
                               class="form-control" />
                    </div>

                    <div class="col-md-12 d-flex gap-2">
                        <button type="submit"
                                class="btn btn-outline-primary">
                            Filter
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Clear
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <strong>Requests</strong>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-muted">
                    No leave requests found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                @if (canViewAllRequests)
                                {
                                    <th>Employee</th>
                                }
                                <th>Leave Type</th>
                                <th>Period</th>
                                <th>Days</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var request in Model)
                            {
                                var days =
                                    request.EndDate.DayNumber -
                                    request.StartDate.DayNumber + 1;

                                <tr>
                                    @if (canViewAllRequests)
                                    {
                                        <td>
                                            <strong>
                                                @request.Employee.FirstName
                                                @request.Employee.LastName
                                            </strong>
                                            <div class="small text-muted">
                                                @request.Employee.EmployeeCode
                                            </div>
                                        </td>
                                    }

                                    <td>@request.LeaveType.Name</td>

                                    <td>
                                        @request.StartDate.ToString("dd MMM yyyy")
                                        -
                                        @request.EndDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>@days</td>

                                    <td>
                                        @if (request.Status == "Approved")
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else if (request.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="Details"
                                               asp-route-id="@request.LeaveRequestId"
                                               class="btn btn-sm btn-outline-secondary">
                                                Details
                                            </a>

                                            @if (request.Status == "Pending" &&
                                                 approvableRequestIds.Contains(request.LeaveRequestId))
                                            {
                                                <form asp-action="Approve"
                                                      asp-route-id="@request.LeaveRequestId"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-sm btn-success"
                                                            onclick="return confirm('Approve this leave request?');">
                                                        Approve
                                                    </button>
                                                </form>

                                                <form asp-action="Reject"
                                                      asp-route-id="@request.LeaveRequestId"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-sm btn-danger"
                                                            onclick="return confirm('Reject this leave request?');">
                                                        Reject
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
