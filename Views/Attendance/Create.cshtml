@model EMPTRACK.Models.ViewModels.AttendanceCreateViewModel

@{
    ViewData["Title"] = "Record Attendance";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Record Attendance</h1>
        <p class="text-muted mb-0">
            Record an employee's check-in and check-out.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="EmployeeId"
                               class="form-label">
                        </label>

                        <select asp-for="EmployeeId"
                                asp-items="ViewBag.Employees"
                                class="form-select">

                            <option value="">
                                -- Select Employee --
                            </option>
                        </select>

                        <span asp-validation-for="EmployeeId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Date"
                               class="form-label">
                        </label>

                        <input asp-for="Date"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Date"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CheckInTime"
                               class="form-label">
                        </label>

                        <input asp-for="CheckInTime"
                               type="time"
                               step="60"
                               class="form-control" />

                        <span asp-validation-for="CheckInTime"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CheckOutTime"
                               class="form-label">
                        </label>

                        <input asp-for="CheckOutTime"
                               type="time"
                               step="60"
                               class="form-control" />

                        <div class="form-text">
                            Leave blank if the employee has not checked out yet.
                        </div>

                        <span asp-validation-for="CheckOutTime"
                              class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Save Attendance
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}