@{
    var isPublicHome =
        ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
        ViewContext.RouteData.Values["action"]?.ToString() == "Index";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EMPTRACK</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EMPTRACK.styles.css" asp-append-version="true" />
</head>
<body class="@(isPublicHome ? "emp-public-body" : "")">

@if (isPublicHome)
{
    <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top emp-public-nav">
        <div class="container">
            <a class="navbar-brand emp-public-brand" asp-controller="Home" asp-action="Index">
                <span class="emp-public-brand-name">EMPTRACK</span>
                <span class="emp-public-brand-subtitle">Employee Management System</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#publicNavbar" aria-controls="publicNavbar"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="publicNavbar">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="#home">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about">About</a>
                    </li>
                    <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                        <a class="btn btn-primary px-4" asp-controller="Account" asp-action="Login">Login</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="emp-public-footer border-top bg-white">
        <div class="container py-3 text-center text-secondary small">
            &copy; 2026 EMPTRACK &mdash; Employee Management System
        </div>
    </footer>
}
else
{
    <div class="app-shell">
        <!-- Mobile top bar -->
        <header class="mobile-topbar d-md-none">
            <button class="btn btn-outline-secondary sidebar-toggle" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#appSidebar"
                    aria-controls="appSidebar" aria-label="Open navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <a class="mobile-brand" asp-controller="Home" asp-action="Index">EMPTRACK</a>
        </header>

        <!-- Side navigation -->
        <aside class="sidebar offcanvas-md offcanvas-start" tabindex="-1" id="appSidebar" aria-label="Main navigation">
            <div class="sidebar-header">
                <a class="sidebar-brand" asp-controller="Home" asp-action="Index">EMPTRACK</a>
                <button type="button" class="btn-close d-md-none" data-bs-dismiss="offcanvas" aria-label="Close navigation"></button>
            </div>

            <div class="sidebar-scroll">
                <nav class="sidebar-nav">
                    <div class="sidebar-section-title">General</div>
                    <a class="sidebar-link" asp-controller="Home" asp-action="Index">
                        <span class="sidebar-icon">⌂</span><span>Home</span>
                    </a>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="sidebar-link" asp-controller="Dashboard" asp-action="Index">
                            <span class="sidebar-icon">▦</span><span>Dashboard</span>
                        </a>

                        <div class="sidebar-section-title">Employee</div>
                        <a class="sidebar-link" asp-controller="Attendance" asp-action="Index">
                            <span class="sidebar-icon">◷</span><span>Attendance</span>
                        </a>
                        <a class="sidebar-link" asp-controller="LeaveRequests" asp-action="Index">
                            <span class="sidebar-icon">▤</span><span>Leave Requests</span>
                        </a>
                        <a class="sidebar-link" asp-controller="Tasks" asp-action="Index">
                            <span class="sidebar-icon">✓</span><span>Tasks</span>
                        </a>
                        <a class="sidebar-link" asp-controller="PerformanceReviews" asp-action="Index">
                            <span class="sidebar-icon">★</span><span>Performance Reviews</span>
                        </a>
                        <a class="sidebar-link" asp-controller="SalaryPayments" asp-action="Index">
                            <span class="sidebar-icon">₹</span><span>Salary Payments</span>
                        </a>
                        <a class="sidebar-link" asp-controller="Notifications" asp-action="Index">
                            <span class="sidebar-icon">●</span><span>Notifications</span>
                        </a>
                        <a class="sidebar-link" asp-controller="Announcements" asp-action="Index">
                            <span class="sidebar-icon">!</span><span>Announcements</span>
                        </a>
                        <a class="sidebar-link" asp-controller="Holidays" asp-action="Index">
                            <span class="sidebar-icon">▣</span><span>Holidays</span>
                        </a>
                        <a class="sidebar-link" asp-controller="Concerns" asp-action="Index">
                            <span class="sidebar-icon">?</span><span>Concerns</span>
                        </a>

                        @if (User.IsInRole("Admin") || User.IsInRole("HR Head") || User.IsInRole("Head Manager") || User.IsInRole("Manager"))
                        {
                            <div class="sidebar-section-title">Organization</div>
                            <a class="sidebar-link" asp-controller="Employees" asp-action="Index">
                                <span class="sidebar-icon">◉</span><span>Employees</span>
                            </a>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("HR Head") || User.IsInRole("Head Manager"))
                        {
                            <a class="sidebar-link" asp-controller="Departments" asp-action="Index">
                                <span class="sidebar-icon">▥</span><span>Departments</span>
                            </a>
                            <a class="sidebar-link" asp-controller="Teams" asp-action="Index">
                                <span class="sidebar-icon">♟</span><span>Teams</span>
                            </a>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("HR Head") || User.IsInRole("HR"))
                        {
                            <div class="sidebar-section-title">Leave Management</div>
                            <a class="sidebar-link" asp-controller="LeaveTypes" asp-action="Index">
                                <span class="sidebar-icon">L</span><span>Leave Types</span>
                            </a>
                            <a class="sidebar-link" asp-controller="LeaveBalances" asp-action="Index">
                                <span class="sidebar-icon">B</span><span>Leave Balances</span>
                            </a>
                        }

                        @if (!User.IsInRole("Admin") && !User.IsInRole("HR Head") && !User.IsInRole("HR"))
                        {
                            <div class="sidebar-section-title">My Information</div>
                            <a class="sidebar-link" asp-controller="LeaveBalances" asp-action="MyBalances">
                                <span class="sidebar-icon">B</span><span>My Leave Balances</span>
                            </a>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("HR Head"))
                        {
                            <div class="sidebar-section-title">Administration</div>
                            <a class="sidebar-link" asp-controller="AuditLogs" asp-action="Index">
                                <span class="sidebar-icon">≡</span><span>Audit Logs</span>
                            </a>
                        }

                        <div class="sidebar-section-title">Account</div>
                        <button type="button" class="sidebar-link sidebar-button" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                            <span class="sidebar-icon">🔒</span><span>Change Password</span>
                        </button>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="sidebar-link sidebar-button">
                                <span class="sidebar-icon">↪</span><span>Logout</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="sidebar-section-title">Account</div>
                        <a class="sidebar-link" asp-controller="Account" asp-action="Login">
                            <span class="sidebar-icon">→</span><span>Login</span>
                        </a>
                    }

                    <a class="sidebar-link" asp-controller="Home" asp-action="Privacy">
                        <span class="sidebar-icon">•</span><span>Privacy</span>
                    </a>
                </nav>
            </div>
        </aside>


            <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header"><h5 class="modal-title" id="changePasswordModalLabel">Change Password</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                        <form asp-controller="Account" asp-action="ChangePassword" method="post">
                            @Html.AntiForgeryToken()
                            <div class="modal-body">
                                @if (TempData["PasswordError"] != null) { <div class="alert alert-danger">@TempData["PasswordError"]</div> }
                                @if (TempData["PasswordSuccess"] != null) { <div class="alert alert-success">@TempData["PasswordSuccess"]</div> }
                                <div class="mb-3"><label class="form-label" for="changeCurrentPassword">Current Password</label><input class="form-control" id="changeCurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" required /></div>
                                <div class="mb-3"><label class="form-label" for="changeNewPassword">New Password</label><input class="form-control" id="changeNewPassword" name="NewPassword" type="password" autocomplete="new-password" required /><div class="form-text">8–15 characters, uppercase, lowercase, number, special character, no spaces.</div></div>
                                <div class="mb-3"><label class="form-label" for="changeConfirmPassword">Confirm New Password</label><input class="form-control" id="changeConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" required /></div>
                            </div>
                            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Change Password</button></div>
                        </form>
                    </div>
                </div>
            </div>

        <!-- Main content -->
        <div class="main-content">
            <main role="main" class="container-fluid page-content">
                @RenderBody()
            </main>

            <footer class="border-top footer text-muted">
                <div class="container-fluid">
                    &copy; 2026 - EMPTRACK - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </footer>
        </div>
    </div>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true && (TempData["PasswordError"] != null || TempData["PasswordSuccess"] != null))
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const modal = document.getElementById("changePasswordModal");
                if (modal && window.bootstrap) bootstrap.Modal.getOrCreateInstance(modal).show();
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
