@model EMPTRACK.Models.ViewModels.TaskCreateViewModel

@{
    ViewData["Title"] = "Create Task";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Create Task</h1>
        <p class="text-muted mb-0">
            Create and assign a new employee task.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title"
                               class="form-control"
                               maxlength="200"
                               placeholder="Enter task title" />
                        <span asp-validation-for="Title"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  maxlength="2000"
                                  placeholder="Describe the task..."></textarea>
                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AssignedEmployeeId"
                               class="form-label"></label>
                        <select asp-for="AssignedEmployeeId"
                                asp-items="ViewBag.Employees"
                                class="form-select">
                            <option value="">-- Select Employee --</option>
                        </select>
                        <span asp-validation-for="AssignedEmployeeId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DueDate" class="form-label"></label>
                        <input asp-for="DueDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="DueDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Priority" class="form-label"></label>
                        <select asp-for="Priority" class="form-select">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                        </select>
                        <span asp-validation-for="Priority"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="alert alert-info mt-4 mb-0">
                    New tasks automatically start with <strong>Pending</strong>
                    status. The creator and creation time are taken from the
                    authenticated account and cannot be entered here.
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Create Task
                    </button>
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
