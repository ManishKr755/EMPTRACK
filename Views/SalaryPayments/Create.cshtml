@model EMPTRACK.Models.ViewModels.SalaryPaymentCreateViewModel

@{
    ViewData["Title"] = "Create Salary Payment";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Create Salary Payment</h1>
        <p class="text-muted mb-0">
            Record a salary payment for an employee.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="EmployeeId"
                               class="form-label">
                        </label>

                        <select asp-for="EmployeeId"
                                asp-items="ViewBag.Employees"
                                class="form-select">

                            <option value="">
                                -- Select Employee --
                            </option>
                        </select>

                        <span asp-validation-for="EmployeeId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PaymentDate"
                               class="form-label">
                        </label>

                        <input asp-for="PaymentDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="PaymentDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Amount"
                               class="form-label">
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                ₹
                            </span>

                            <input asp-for="Amount"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   class="form-control"
                                   placeholder="0.00" />
                        </div>

                        <span asp-validation-for="Amount"
                              class="text-danger"></span>

                        <div class="form-text">
                            Maximum two decimal places.
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Create Payment
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}