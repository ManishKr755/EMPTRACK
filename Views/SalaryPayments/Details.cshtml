@model EMPTRACK.Models.SalaryPayment

@{
    ViewData["Title"] = "Salary Payment Details";

    var isSalaryAdministrator = User.IsInRole("Admin") ||
                                User.IsInRole("HR Head") ||
                                User.IsInRole("HR");
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Salary Payment Details</h1>
            <p class="text-muted mb-0">
                Payment #@Model.PaymentId
            </p>
        </div>

        <div class="d-flex gap-2">
            @if (isSalaryAdministrator)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.PaymentId"
                   class="btn btn-primary">
                    Edit
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.PaymentId"
                   class="btn btn-outline-danger">
                    Delete
                </a>
            }

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Payment Information</strong>
                </div>

                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Employee</dt>
                        <dd class="col-sm-8">
                            <strong>
                                @Model.Employee.EmployeeCode -
                                @Model.Employee.FirstName
                                @Model.Employee.LastName
                            </strong>
                        </dd>

                        <dt class="col-sm-4">Payment Date</dt>
                        <dd class="col-sm-8">
                            @Model.PaymentDate.ToString("dd MMMM yyyy")
                        </dd>

                        <dt class="col-sm-4">Amount</dt>
                        <dd class="col-sm-8">
                            <strong class="fs-4">
                                ₹@Model.Amount.ToString("N2")
                            </strong>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
