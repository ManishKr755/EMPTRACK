@model EMPTRACK.Models.SalaryPayment

@{
    ViewData["Title"] = "Delete Salary Payment";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Delete Salary Payment</h1>
        <p class="text-muted mb-0">
            Confirm that you want to remove this payment record.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="alert alert-warning">
                Are you sure you want to delete this salary payment?
            </div>

            <dl class="row">
                <dt class="col-sm-3">Employee</dt>
                <dd class="col-sm-9">
                    @Model.Employee.EmployeeCode -
                    @Model.Employee.FirstName
                    @Model.Employee.LastName
                </dd>

                <dt class="col-sm-3">Payment Date</dt>
                <dd class="col-sm-9">
                    @Model.PaymentDate.ToString("dd MMMM yyyy")
                </dd>

                <dt class="col-sm-3">Amount</dt>
                <dd class="col-sm-9">
                    ₹@Model.Amount.ToString("N2")
                </dd>
            </dl>

            <form asp-action="DeleteConfirmed"
                  asp-route-id="@Model.PaymentId"
                  method="post">
                @Html.AntiForgeryToken()

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-danger">
                        Yes, Delete
                    </button>

                    <a asp-action="Details"
                       asp-route-id="@Model.PaymentId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
