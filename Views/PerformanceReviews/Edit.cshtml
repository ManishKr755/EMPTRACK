@model EMPTRACK.Models.ViewModels.PerformanceReviewEditViewModel

@{
    ViewData["Title"] = "Edit Performance Review";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Edit Performance Review</h1>
        <p class="text-muted mb-0">
            Update the review details.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit"
                  asp-route-id="@Model.ReviewId"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="ReviewId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="EmployeeId" class="form-label"></label>

                        <select asp-for="EmployeeId"
                                asp-items="ViewBag.Employees"
                                class="form-select">
                            <option value="">-- Select Employee --</option>
                        </select>

                        <span asp-validation-for="EmployeeId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ReviewDate" class="form-label"></label>

                        <input asp-for="ReviewDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="ReviewDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Rating" class="form-label"></label>

                        <select asp-for="Rating" class="form-select">
                            <option value="1">1 - Very Poor</option>
                            <option value="2">2 - Needs Improvement</option>
                            <option value="3">3 - Satisfactory</option>
                            <option value="4">4 - Very Good</option>
                            <option value="5">5 - Excellent</option>
                        </select>

                        <span asp-validation-for="Rating"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Feedback" class="form-label"></label>

                        <textarea asp-for="Feedback"
                                  class="form-control"
                                  rows="7"
                                  maxlength="1000"></textarea>

                        <span asp-validation-for="Feedback"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="alert alert-light border mt-4 mb-0">
                    The reviewer is controlled by the application and cannot be changed here.
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Details"
                       asp-route-id="@Model.ReviewId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
