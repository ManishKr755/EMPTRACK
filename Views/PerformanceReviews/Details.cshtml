@model EMPTRACK.Models.PerformanceReview

@{
    ViewData["Title"] = "Performance Review Details";
    var currentEmployeeId = User.FindFirst("EmployeeId")?.Value;
    var canManage =
        User.IsInRole("Admin") ||
        currentEmployeeId == Model.ReviewerEmployeeId.ToString();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Performance Review</h1>
        </div>

        <div class="d-flex gap-2">
            @if (canManage)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.ReviewId"
                   class="btn btn-primary">
                    Edit
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.ReviewId"
                   class="btn btn-outline-danger">
                    Delete
                </a>
            }

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Review Information</strong>
                </div>

                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Employee</dt>
                        <dd class="col-sm-8">
                            <strong>
                                @Model.Employee.FirstName
                                @Model.Employee.LastName
                            </strong>

                            <div class="small text-muted">
                                @Model.Employee.EmployeeCode
                            </div>
                        </dd>

                        <dt class="col-sm-4">Reviewer</dt>
                        <dd class="col-sm-8">
                            <strong>
                                @Model.Reviewer.FirstName
                                @Model.Reviewer.LastName
                            </strong>

                            <div class="small text-muted">
                                @Model.Reviewer.EmployeeCode
                            </div>
                        </dd>

                        <dt class="col-sm-4">Review Date</dt>
                        <dd class="col-sm-8">
                            @Model.ReviewDate.ToString("dd MMMM yyyy")
                        </dd>

                        <dt class="col-sm-4">Rating</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary fs-6">
                                @Model.Rating / 5
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Rating</strong>
                </div>

                <div class="card-body text-center">
                    <div class="display-5 fw-bold">
                        @Model.Rating
                    </div>

                    <div class="text-muted">
                        out of 5
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header">
                    <strong>Feedback</strong>
                </div>

                <div class="card-body">
                    <div class="border rounded p-4 bg-light">
                        @Model.Feedback
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
