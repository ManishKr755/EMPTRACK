@model EMPTRACK.Models.PerformanceReview

@{
    ViewData["Title"] = "Delete Performance Review";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Delete Performance Review</h1>
        <p class="text-muted mb-0">
            Confirm that you want to permanently delete this review.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="alert alert-warning">
                This action cannot be undone.
            </div>

            <dl class="row">
                <dt class="col-sm-3">Reviewed Employee</dt>
                <dd class="col-sm-9">
                    @Model.Employee.FirstName @Model.Employee.LastName
                    <div class="small text-muted">
                        @Model.Employee.EmployeeCode
                    </div>
                </dd>

                <dt class="col-sm-3">Reviewer</dt>
                <dd class="col-sm-9">
                    @Model.Reviewer.FirstName @Model.Reviewer.LastName
                    <div class="small text-muted">
                        @Model.Reviewer.EmployeeCode
                    </div>
                </dd>

                <dt class="col-sm-3">Review Date</dt>
                <dd class="col-sm-9">
                    @Model.ReviewDate.ToString("dd MMMM yyyy")
                </dd>

                <dt class="col-sm-3">Rating</dt>
                <dd class="col-sm-9">@Model.Rating / 5</dd>
            </dl>

            <hr />

            <form asp-action="Delete"
                  asp-route-id="@Model.ReviewId"
                  method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Delete Review
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.ReviewId"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
