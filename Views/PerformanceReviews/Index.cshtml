@model IEnumerable<EMPTRACK.Models.PerformanceReview>

@{
    ViewData["Title"] = "Performance Reviews";
    var currentEmployeeId = User.FindFirst("EmployeeId")?.Value;
    var canCreate = User.IsInRole("Manager")
        || User.IsInRole("Head Manager")
        || User.IsInRole("HR Head");
    var isAdmin = User.IsInRole("Admin");
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Performance Reviews</h1>
            <p class="text-muted mb-0">
                View performance reviews you are allowed to access.
            </p>
        </div>

        @if (canCreate)
        {
            <a asp-action="Create" class="btn btn-primary">
                + New Review
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    @if (isAdmin)
                    {
                        <div class="col-md-3">
                            <label class="form-label">Search</label>
                            <input name="search"
                                   value="@ViewData["Search"]"
                                   class="form-control"
                                   placeholder="Employee or feedback..." />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Employee</label>
                            <select name="employeeId"
                                    asp-items="ViewBag.Employees"
                                    class="form-select">
                                <option value="">All Employees</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Reviewer</label>
                            <select name="reviewerEmployeeId"
                                    asp-items="ViewBag.Reviewers"
                                    class="form-select">
                                <option value="">All Reviewers</option>
                            </select>
                        </div>
                    }

                    <div class="col-md-2">
                        <label class="form-label">Rating</label>
                        <select name="rating" class="form-select">
                            <option value="">All Ratings</option>

                            @for (var i = 1; i <= 5; i++)
                            {
                                if (ViewData["Rating"]?.ToString() == i.ToString())
                                {
                                    <option value="@i" selected>@i / 5</option>
                                }
                                else
                                {
                                    <option value="@i">@i / 5</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit"
                                class="btn btn-outline-primary w-100">
                            Filter
                        </button>
                    </div>
                </div>

                <div class="mt-3">
                    <a asp-action="Index"
                       class="btn btn-sm btn-outline-secondary">
                        Clear Filters
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <strong>Review List</strong>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-muted">
                    No performance reviews found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Employee</th>
                                <th>Reviewer</th>
                                <th>Review Date</th>
                                <th>Rating</th>
                                <th>Feedback</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var review in Model)
                            {
                                var canManage =
                                    isAdmin ||
                                    currentEmployeeId == review.ReviewerEmployeeId.ToString();

                                <tr>
                                    <td>
                                        <strong>
                                            @review.Employee.FirstName
                                            @review.Employee.LastName
                                        </strong>

                                        <div class="small text-muted">
                                            @review.Employee.EmployeeCode
                                        </div>
                                    </td>

                                    <td>
                                        @review.Reviewer.FirstName
                                        @review.Reviewer.LastName

                                        <div class="small text-muted">
                                            @review.Reviewer.EmployeeCode
                                        </div>
                                    </td>

                                    <td>
                                        @review.ReviewDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @review.Rating / 5
                                        </span>
                                    </td>

                                    <td>
                                        @{
                                            var feedback = review.Feedback ?? string.Empty;
                                        }

                                        @(feedback.Length > 80
                                            ? feedback.Substring(0, 80) + "..."
                                            : feedback)
                                    </td>

                                    <td class="text-end">
                                        <a asp-action="Details"
                                           asp-route-id="@review.ReviewId"
                                           class="btn btn-sm btn-outline-secondary">
                                            Details
                                        </a>

                                        @if (canManage)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@review.ReviewId"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@review.ReviewId"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
