@model IEnumerable<EMPTRACK.Models.LeaveBalance>

@{
    ViewData["Title"] = "Leave Balances";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Leave Balances</h1>
            <p class="text-muted mb-0">
                Manage employee leave balances.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + Add Leave Balance
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index"
                  method="get">

                <div class="row g-3">
                    <div class="col-md-5">
                        <label for="employeeId"
                               class="form-label">
                            Employee
                        </label>

                        <select id="employeeId"
                                name="employeeId"
                                asp-items="ViewBag.EmployeeFilter"
                                class="form-select">

                            <option value="">
                                All Employees
                            </option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label for="leaveTypeId"
                               class="form-label">
                            Leave Type
                        </label>

                        <select id="leaveTypeId"
                                name="leaveTypeId"
                                asp-items="ViewBag.LeaveTypeFilter"
                                class="form-select">

                            <option value="">
                                All Leave Types
                            </option>
                        </select>
                    </div>

                    <div class="col-md-3 d-flex align-items-end gap-2">
                        <button type="submit"
                                class="btn btn-outline-primary">
                            Filter
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Clear
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <strong>Leave Balances</strong>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-muted">
                    No leave balances found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Employee</th>
                                <th>Employee Code</th>
                                <th>Leave Type</th>
                                <th>Allocation</th>
                                <th>Available Leaves</th>
                                <th class="text-end">
                                    Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var balance in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>
                                            @balance.Employee.FirstName
                                            @balance.Employee.LastName
                                        </strong>
                                    </td>

                                    <td>
                                        @balance.Employee.EmployeeCode
                                    </td>

                                    <td>
                                        @balance.LeaveType.Name
                                    </td>

                                    <td>
                                        @balance.LeaveType.AllocationType
                                        (@balance.LeaveType.AllocationLimit.ToString("0.##"))
                                    </td>

                                    <td>
                                        @balance.AvailableLeaves.ToString("0.##")
                                    </td>

                                    <td class="text-end">
                                        <div class="btn-group"
                                             role="group">

                                            <a asp-action="Details"
                                               asp-route-id="@balance.LeaveBalanceId"
                                               class="btn btn-sm btn-outline-secondary">
                                                Details
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@balance.LeaveBalanceId"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>