@model IEnumerable<EMPTRACK.Models.ViewModels.EmployeeLeaveBalanceSummaryViewModel>
@{
    ViewData["Title"] = "Leave Balances";
}
<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Leave Balances</h1>
        <p class="text-muted mb-0">One row per employee. Balances renew automatically and approved leave is deducted from the employee's available balance.</p>
    </div>
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label for="employeeId" class="form-label">Employee</label>
                        <select id="employeeId" name="employeeId" asp-items="ViewBag.EmployeeFilter" class="form-select"><option value="">All Employees</option></select>
                    </div>
                    <div class="col-md-4">
                        <label for="leaveTypeId" class="form-label">Leave Type</label>
                        <select id="leaveTypeId" name="leaveTypeId" asp-items="ViewBag.LeaveTypeFilter" class="form-select"><option value="">All Leave Types</option></select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-outline-primary">Filter</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="card shadow-sm">
        <div class="card-header"><strong>Employee Leave Summary</strong></div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-muted">No employees found.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light"><tr><th>Employee</th><th>Employee Code</th><th>Total Allocated</th><th>Total Used*</th><th>Available Leaves</th><th class="text-end">Actions</th></tr></thead>
                        <tbody>
                        @foreach (var employee in Model)
                        {
                            <tr>
                                <td><strong>@employee.EmployeeName</strong></td>
                                <td>@employee.EmployeeCode</td>
                                <td>@employee.TotalAllocated.ToString("0.##")</td>
                                <td>@employee.TotalUsed.ToString("0.##")</td>
                                <td><strong>@employee.TotalAvailable.ToString("0.##")</strong></td>
                                <td class="text-end"><a asp-action="Details" asp-route-id="@employee.EmployeeId" class="btn btn-sm btn-outline-primary">Details</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <p class="text-muted small p-3 mb-0">*Used is an estimate based on allocated minus available; monthly accruals may affect this figure. Details shows every leave type, including zero balances.</p>
            }
        </div>
    </div>
</div>
