@model EMPTRACK.Models.ViewModels.LeaveBalanceEditViewModel

@{
    ViewData["Title"] = "Edit Leave Balance";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Edit Leave Balance</h1>
        <p class="text-muted mb-0">
            Change the available leave days. Employee and Leave Type are fixed.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit"
                  asp-route-id="@Model.LeaveBalanceId"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="LeaveBalanceId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Employee</label>
                    <div class="form-control-plaintext">
                        @Model.EmployeeDisplayName
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Leave Type</label>
                    <div class="form-control-plaintext">
                        @Model.LeaveTypeDisplayName
                    </div>
                </div>

                <div class="col-md-6 px-0">
                    <label asp-for="AvailableLeaves"
                           class="form-label">
                    </label>

                    <input asp-for="AvailableLeaves"
                           type="number"
                           min="0"
                           max="999.99"
                           step="0.01"
                           class="form-control" />

                    <span asp-validation-for="AvailableLeaves"
                          class="text-danger"></span>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Details"
                       asp-route-id="@Model.LeaveBalanceId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
