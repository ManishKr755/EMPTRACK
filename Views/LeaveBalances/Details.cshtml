@model EMPTRACK.Models.ViewModels.EmployeeLeaveBalanceDetailViewModel
@{
    ViewData["Title"] = "Employee Leave Balance Details";
}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="h3 mb-1">Leave Balance Details</h1>
            <p class="text-muted mb-0">@Model.EmployeeName · @Model.EmployeeCode</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Leave Balances</a>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total Allocated</div><div class="h3 mb-0">@Model.TotalAllocated.ToString("0.##")</div></div></div></div>
        <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total Available</div><div class="h3 mb-0">@Model.TotalAvailable.ToString("0.##")</div></div></div></div>
        <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Used</div><div class="h3 mb-0">@Math.Max(0, Model.TotalAllocated - Model.TotalAvailable).ToString("0.##")</div></div></div></div>
    </div>
    <div class="card shadow-sm">
        <div class="card-header"><strong>Breakdown by Leave Type</strong></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th>Leave Type</th><th>Allocation Period</th><th>Allocated per Period</th><th>Used</th><th>Available</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var leave in Model.LeaveTypes)
                    {
                        <tr>
                            <td><strong>@leave.Name</strong></td><td>@leave.AllocationType</td><td>@leave.Allocated.ToString("0.##")</td><td>@leave.Used.ToString("0.##")</td><td><strong>@leave.Available.ToString("0.##")</strong></td>
                            <td>@if (leave.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Inactive</span> }</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
