@model IEnumerable<EMPTRACK.Models.Notification>

@{
    ViewData["Title"] = "My Notifications";
    var isManagementUser =
        User.IsInRole("Admin") ||
        User.IsInRole("HR Head") ||
        User.IsInRole("HR") ||
        User.IsInRole("Head Manager") ||
        User.IsInRole("Manager");

    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                @(isManagementUser ? "Notifications" : "My Notifications")
            </h1>
            <p class="text-muted mb-0">
                @(isManagementUser
                    ? "View employee notifications."
                    : "View your notifications.")
            </p>
        </div>

        <div class="d-flex gap-2">
            @if (isManagementUser)
            {
                <a asp-action="Create"
                   class="btn btn-primary">
                    + New Notification
                </a>
            }

            @if (unreadCount > 0 && Model.Any(n => User.FindFirst("EmployeeId")?.Value == n.EmployeeId.ToString() && !n.IsRead))
            {
                <form asp-action="MarkAllAsRead" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-success">
                        Mark My Notifications as Read
                    </button>
                </form>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Notification List</strong>

            @if (!isManagementUser)
            {
                <span class="badge bg-primary">
                    Unread: @unreadCount
                </span>
            }
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-muted">
                    No notifications found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Status</th>

                                @if (isManagementUser)
                                {
                                    <th>Employee</th>
                                }

                                <th>Title</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var notification in Model)
                            {
                                <tr class="@(
                                    notification.IsRead
                                        ? ""
                                        : "table-warning")">

                                    <td>
                                        @if (notification.IsRead)
                                        {
                                            <span class="badge bg-success">
                                                Read
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Unread
                                            </span>
                                        }
                                    </td>

                                    @if (isManagementUser)
                                    {
                                        <td>
                                            <strong>
                                                @notification.Employee.FirstName
                                                @notification.Employee.LastName
                                            </strong>

                                            <div class="small text-muted">
                                                @notification.Employee.EmployeeCode
                                            </div>
                                        </td>
                                    }

                                    <td>
                                        <strong>
                                            @notification.Title
                                        </strong>

                                        <div class="small text-muted">
                                            @(notification.Message.Length > 80
                                                ? notification.Message[..80] + "..."
                                                : notification.Message)
                                        </div>
                                    </td>

                                    <td>
                                        @notification.CreatedAt.ToString("dd MMM yyyy")

                                        <div class="small text-muted">
                                            @notification.CreatedAt.ToString("hh:mm tt")
                                        </div>
                                    </td>

                                    <td class="text-end">
                                        <a asp-action="Details"
                                           asp-route-id="@notification.NotificationId"
                                           class="btn btn-sm btn-outline-secondary">
                                            Details
                                        </a>

                                        @if (User.FindFirst("EmployeeId")?.Value == notification.EmployeeId.ToString() && !notification.IsRead)
                                        {
                                            <form asp-action="MarkAsRead"
                                                  asp-route-id="@notification.NotificationId"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success">
                                                    Mark Read
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
