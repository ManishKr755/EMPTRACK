@model EMPTRACK.Models.ViewModels.UserAccountResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="container-fluid">

    <div class="mb-4">

        <h1 class="h3 mb-1">
            Reset Password
        </h1>

        <p class="text-muted">
            Change the password for
            <strong>@Model.Username</strong>.
        </p>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="ResetPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="UserAccountId"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="NewPassword"
                           class="form-label">
                    </label>

                    <input asp-for="NewPassword"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="NewPassword"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-4">

                    <label asp-for="ConfirmPassword"
                           class="form-label">
                    </label>

                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-warning">
                    Reset Password
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.UserAccountId"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}