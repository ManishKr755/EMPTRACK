@model EMPTRACK.Models.ViewModels.UserAccountEditViewModel
@{ ViewData["Title"] = "Edit User Account"; }
<div class="container-fluid"><div class="mb-4"><h1 class="h3">Edit User Account</h1><p class="text-muted">Manage account status. Employee usernames are generated automatically.</p></div><div class="card shadow-sm"><div class="card-body"><form asp-action="Edit" method="post">@Html.AntiForgeryToken()<input asp-for="UserAccountId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label class="form-label">Username</label><input class="form-control" value="@Model.Username" readonly /></div><div class="mb-3"><label class="form-label">Employee ID</label><input class="form-control" value="@(Model.EmployeeId?.ToString() ?? "Not linked")" readonly /></div><div class="form-check mb-4"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div><button type="submit" class="btn btn-primary">Save Changes</button><a asp-action="Details" asp-route-id="@Model.UserAccountId" class="btn btn-outline-secondary ms-2">Cancel</a></form></div></div></div>

@section Scripts{<partial name="_ValidationScriptsPartial" /> }