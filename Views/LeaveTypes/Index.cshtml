@model IEnumerable<EMPTRACK.Models.LeaveType>

@{
    ViewData["Title"] = "Leave Types";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Leave Types</h1>
            <p class="text-muted mb-0">Manage leave types and their annual/monthly limits.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">+ Add Leave Type</a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label for="search" class="form-label">Search</label>
                        <input type="text" id="search" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search leave type..." />
                    </div>
                    <div class="col-md-4 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-outline-primary">Search</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-muted">No leave types found.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Allocation</th>
                                <th>Limit</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var leaveType in Model)
                        {
                            <tr>
                                <td><strong>@leaveType.Name</strong></td>
                                <td>@leaveType.AllocationType</td>
                                <td>@leaveType.AllocationLimit.ToString("0.##")</td>
                                <td>
                                    @if (leaveType.IsActive)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@leaveType.LeaveTypeId" class="btn btn-sm btn-outline-secondary">Details</a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@leaveType.LeaveTypeId" class="btn btn-sm btn-outline-primary">Edit</a>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
