@model EMPTRACK.Models.ViewModels.LeaveTypeCreateViewModel

@{
    ViewData["Title"] = "Create Leave Type";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">Create Leave Type</h1>
        <p class="text-muted mb-0">Set the leave name and how many leaves employees receive.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Casual Leave" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="AllocationType" class="form-label"></label>
                        <select asp-for="AllocationType" class="form-select">
                            <option value="Annually">Annually</option>
                            <option value="Monthly">Monthly</option>
                        </select>
                        <span asp-validation-for="AllocationType" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="AllocationLimit" class="form-label"></label>
                        <input asp-for="AllocationLimit" type="number" min="0.01" max="999.99" step="0.01" class="form-control" />
                        <span asp-validation-for="AllocationLimit" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label d-block">Status</label>
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" role="switch" />
                            <label asp-for="IsActive" class="form-check-label">Active</label>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info mt-4 mb-0">
                    <strong>Example:</strong> Annually + 12 means 12 leaves per year.
                    Monthly + 1 means 1 leave per month.
                </div>

                <hr class="my-4" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create Leave Type</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
