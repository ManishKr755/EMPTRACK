# Build outputs
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Aa]rtifacts/
publish/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.sln.ide

# Rider / JetBrains
.idea/
*.sln.iml
*.DotSettings.user

# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# .NET tooling
project.lock.json
project.fragment.lock.json
artifacts/
TestResults/
coverage/
coverage.*

# NuGet packages and temporary files
*.nupkg
*.snupkg
.nuget/

# Logs and diagnostic files
*.log
logs/
*.tlog
*.stackdump
*.dmp

# Local environment variables and secrets
.env
.env.*
!.env.example
secrets.json
appsettings.Local.json
appsettings.Development.local.json

# User-specific configuration
*.local.json

# Database files - local development only
*.mdf
*.ldf
*.db-shm
*.db-wal

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary and backup files
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
*~

# ASP.NET Core Data Protection keys
key-*.xml
DataProtection-Keys/
dp_keys/

# Publish profiles may contain credentials
Properties/PublishProfiles/*.pubxml
Properties/PublishProfiles/*.publishsettings

# Azure / deployment local settings
.azure/

# Node.js (if frontend tooling is added)
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Keep source code, project files, migrations,
# static assets, Razor views, and documentation tracked.
